<script>
require(['jquery', 'Magento_Ui/js/modal/alert'], function ($, uiAlert) {
    'use strict';

    var root = $('.exemptax-company-settings');
    if (!root.length) {
        return;
    }

    var statusUrl = root.data('status-url');
    var saveUrl = root.data('save-url');
    var formKey = root.data('form-key');
    var $engine = $('#exemptax_tax_engine');
    var $flag = $('#exemptax_tax_exempt_flag');
    var $legacy = $('#exemptax_grandfathered_entire_exemption');
    var $groups = $('#exemptax_ac_customer_groups');
    var $syncTags = $('#exemptax_sync_customer_tags');
    var $save = $('#exemptax-settings-save');
    var $refresh = $('#exemptax-settings-refresh');
    var $confirmWrap = root.find('.exemptax-settings-confirm');
    var $confirm = $('#exemptax_settings_confirm');
    var $locked = root.find('.exemptax-settings-locked');
    var $lastSync = root.find('.exemptax-last-sync-value');
    var $msg = $('#exemptax-settings-message');
    var pollTimer = null;

    function allGroupIds() {
        return $groups.find('option').map(function () {
            return String($(this).val());
        }).get();
    }

    function applyCustomerGroups(selected) {
        var allIds = allGroupIds();
        if (!selected || !selected.length) {
            $groups.val(allIds);
            return;
        }
        $groups.val(selected.map(String));
    }

    function setMessage(text, isError) {
        $msg.text(text || '');
        $msg.css('color', isError ? '#e22626' : '#006400');
    }

    function formatLastSync(raw) {
        if (!raw) {
            return '<?= $block->escapeJs(__('Waiting for sync…')) ?>';
        }
        var d = new Date(raw);
        if (isNaN(d.getTime())) {
            return raw;
        }
        // Browser local timezone (machine time), not Magento admin / UTC.
        return d.toLocaleString(undefined, {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: 'numeric',
            minute: '2-digit'
        });
    }

    function paintLastSync(raw) {
        $lastSync.attr('data-raw', raw || '');
        $lastSync.text(formatLastSync(raw));
    }

    function updateSaveEnabled() {
        var locked = $engine.prop('disabled');
        $save.prop('disabled', locked || !$confirm.is(':checked'));
    }

    function applyState(data) {
        if (!data) {
            return;
        }
        if (data.tax_engine) {
            $engine.val(data.tax_engine);
        }
        if (typeof data.tax_exempt_flag !== 'undefined') {
            var flag = Number(data.tax_exempt_flag);
            $flag.val(String(flag === 3 ? 2 : flag));
        }
        if (typeof data.grandfathered_entire_exemption !== 'undefined') {
            $legacy.val(String(Number(data.grandfathered_entire_exemption) ? 1 : 0));
        }
        applyCustomerGroups(data.ac_customer_groups);
        if (typeof data.sync_customer_tags !== 'undefined') {
            $syncTags.val(String(Number(data.sync_customer_tags) ? 1 : 0));
        }
        var locked = !!data.locked;
        $engine.prop('disabled', locked);
        $flag.prop('disabled', locked);
        $legacy.prop('disabled', locked);
        $groups.prop('disabled', locked);
        $syncTags.prop('disabled', locked);
        $locked.toggle(locked);
        $save.toggle(!locked);
        $refresh.toggle(locked);
        $confirmWrap.toggle(!locked);
        if (locked) {
            $confirm.prop('checked', false);
            paintLastSync(null);
            startPoll();
        } else {
            stopPoll();
            paintLastSync(data.last_sync_at || null);
        }
        updateSaveEnabled();
    }

    function startPoll() {
        if (pollTimer) {
            return;
        }
        pollTimer = setInterval(function () {
            refreshStatus(true);
        }, 5000);
    }

    function stopPoll() {
        if (pollTimer) {
            clearInterval(pollTimer);
            pollTimer = null;
        }
    }

    function refreshStatus(silent) {
        if (!silent) {
            setMessage('<?= $block->escapeJs(__('Refreshing…')) ?>', false);
        }
        $.ajax({
            url: statusUrl,
            type: 'GET',
            dataType: 'json',
            data: { form_key: formKey }
        }).done(function (resp) {
            if (resp && resp.success) {
                applyState(resp.data || {});
                if (!silent) {
                    setMessage(resp.message || '', false);
                } else if (resp.data && !resp.data.locked) {
                    setMessage('<?= $block->escapeJs(__('Sync complete. Settings unlocked.')) ?>', false);
                    uiAlert({
                        title: '<?= $block->escapeJs(__('EXEMPTAX')) ?>',
                        content: '<?= $block->escapeJs(__('Sync complete. Integration settings are unlocked.')) ?>'
                    });
                }
            } else if (!silent) {
                setMessage((resp && resp.message) || '<?= $block->escapeJs(__('Could not refresh settings.')) ?>', true);
            }
        }).fail(function (xhr) {
            if (!silent) {
                var msg = (xhr.responseJSON && xhr.responseJSON.message) || '<?= $block->escapeJs(__('Could not refresh settings.')) ?>';
                setMessage(msg, true);
            }
        });
    }

    $confirm.on('change', updateSaveEnabled);

    $refresh.on('click', function (e) {
        e.preventDefault();
        refreshStatus(false);
    });

    $save.on('click', function (e) {
        e.preventDefault();
        if (!$confirm.is(':checked')) {
            setMessage('<?= $block->escapeJs(__('Please confirm you have reviewed the settings.')) ?>', true);
            return;
        }
        setMessage('<?= $block->escapeJs(__('Saving…')) ?>', false);
        $save.prop('disabled', true);
        $.ajax({
            url: saveUrl,
            type: 'POST',
            dataType: 'json',
            traditional: true,
            data: {
                form_key: formKey,
                tax_engine: $engine.val(),
                tax_exempt_flag: $flag.val(),
                grandfathered_entire_exemption: $legacy.val(),
                ac_customer_groups: $groups.val() || [],
                sync_customer_tags: $syncTags.val()
            }
        }).done(function (resp) {
            if (resp && resp.success) {
                applyState(resp.data || {});
                var msg = resp.message || '<?= $block->escapeJs(__('Settings saved.')) ?>';
                setMessage(msg, false);
                uiAlert({
                    title: '<?= $block->escapeJs(__('EXEMPTAX')) ?>',
                    content: msg
                });
            } else {
                setMessage((resp && resp.message) || '<?= $block->escapeJs(__('Could not save settings.')) ?>', true);
                if (resp && resp.data) {
                    applyState(resp.data);
                }
            }
        }).fail(function (xhr) {
            var msg = (xhr.responseJSON && xhr.responseJSON.message) || '<?= $block->escapeJs(__('Could not save settings.')) ?>';
            setMessage(msg, true);
            if (xhr.responseJSON && xhr.responseJSON.data) {
                applyState(xhr.responseJSON.data);
            }
            uiAlert({
                title: '<?= $block->escapeJs(__('EXEMPTAX')) ?>',
                content: msg
            });
        }).always(function () {
            updateSaveEnabled();
        });
    });

    // Initial paint in machine local time (server only sends UTC ISO).
    paintLastSync($lastSync.attr('data-raw') || null);

    updateSaveEnabled();
    if (root.data('locked') === 1 || root.data('locked') === '1') {
        startPoll();
    }
});
</script>
