<?php
/** @var \Exemptax\Integration\Block\Customer\EcommerceDropLink $block */
$mode = (string) $block->getData('mode'); // popup|iframe|link
$label = $block->escapeHtml($block->getLinkLabel());
?>
<?php if ($mode === 'iframe' && !$block->isCustomerLoggedIn()): ?>
    <div class="exemptax-ecommerce-drop-login message info" style="margin: 1.5rem 0;">
        <span><?= $block->escapeHtml(__('Please sign in to submit or review your tax exemption certificates.')) ?></span>
        <a href="<?= $block->escapeUrl($block->getLoginUrl()) ?>">
            <?= $block->escapeHtml(__('Sign In')) ?>
        </a>
    </div>
<?php elseif ($block->isVisible()): ?>
    <?php if ($mode === 'iframe'): ?>
        <div class="exemptax-ecommerce-drop-iframe" style="margin: 1.5rem 0;">
            <?php if ($block->shouldShowHeading()): ?>
                <h2 class="legend"><?= $label ?></h2>
            <?php endif; ?>
            <iframe
                title="<?= $label ?>"
                src="<?= $block->escapeUrl($block->getEcommerceDropUrl()) ?>"
                allow="geolocation; microphone; camera"
                allowfullscreen="true"
                allowtransparency="true"
                frameborder="0"
                scrolling="auto"
                style="min-width: 100%; height: 800px; overflow: auto; border: 0;"
            ></iframe>
        </div>
    <?php elseif ($mode === 'popup'): ?>
        <li class="nav item">
            <a href="<?= $block->escapeUrl($block->getCertificatesPageUrl()) ?>">
                <?= $label ?>
            </a>
        </li>
        <li class="nav item">
            <a href="#"
               onclick="window.open(
                   '<?= $block->escapeJs($block->getEcommerceDropUrl()) ?>',
                   'exemptionRequest',
                   'left=50,top=100,width=1000,height=600,menubar=0,toolbar=0,location=0,status=0'
               ); return false;">
                <?= $label ?> (<?= $block->escapeHtml(__('Popup')) ?>)
            </a>
        </li>
    <?php else: ?>
        <li class="nav item">
            <a href="<?= $block->escapeUrl($block->getEcommerceDropUrl()) ?>" target="_blank" rel="noopener noreferrer">
                <?= $label ?>
            </a>
        </li>
    <?php endif; ?>
<?php endif; ?>
