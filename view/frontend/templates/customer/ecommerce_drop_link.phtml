<?php
/** @var \Exemptax\Integration\Block\Customer\EcommerceDropLink $block */
if (!$block->isVisible()) {
    return;
}
$url = $block->getEcommerceDropUrl();
$label = $block->escapeHtml($block->getLinkLabel());
$mode = (string) $block->getData('mode'); // popup|iframe|link
?>
<?php if ($mode === 'iframe'): ?>
    <div class="exemptax-ecommerce-drop-iframe" style="margin: 1.5rem 0;">
        <h2 class="legend"><?= $label ?></h2>
        <iframe
            title="<?= $label ?>"
            src="<?= $block->escapeUrl($url) ?>"
            allow="geolocation; microphone; camera"
            allowfullscreen="true"
            allowtransparency="true"
            frameborder="0"
            scrolling="auto"
            style="min-width: 100%; height: 800px; overflow: auto; border: 0;"
        ></iframe>
    </div>
<?php elseif ($mode === 'popup'): ?>
    <li class="nav item">
        <a href="#"
           onclick="window.open(
               '<?= $block->escapeJs($url) ?>',
               'exemptionRequest',
               'left=50,top=100,width=1000,height=600,menubar=0,toolbar=0,location=0,status=0'
           ); return false;">
            <?= $label ?> (<?= $block->escapeHtml(__('Popup')) ?>)
        </a>
    </li>
    <li class="nav item">
        <a href="<?= $block->escapeUrl($url) ?>" target="_blank" rel="noopener noreferrer">
            <?= $label ?> (<?= $block->escapeHtml(__('New Tab')) ?>)
        </a>
    </li>
<?php else: ?>
    <li class="nav item">
        <a href="<?= $block->escapeUrl($url) ?>" target="_blank" rel="noopener noreferrer">
            <?= $label ?>
        </a>
    </li>
<?php endif; ?>
