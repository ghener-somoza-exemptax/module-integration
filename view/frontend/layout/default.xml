<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Core Magento_Theme footer_links (Html\Links). Present on Luma without Sample Data. -->
        <referenceBlock name="footer_links">
            <block class="Exemptax\Integration\Block\Customer\EcommerceDropLink"
                   name="exemptax.footer.ecommerce.drop"
                   template="Exemptax_Integration::customer/ecommerce_drop_link.phtml"
                   cacheable="false"
                   after="-">
                <arguments>
                    <argument name="mode" xsi:type="string">popup</argument>
                    <argument name="link_label" xsi:type="string" translate="true">Tax-Exempt Certificates</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
