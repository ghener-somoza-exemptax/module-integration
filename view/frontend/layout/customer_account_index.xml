<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- My Account dashboard: iframe embed (not in footer) -->
        <referenceContainer name="content">
            <block class="Exemptax\Integration\Block\Customer\EcommerceDropLink"
                   name="exemptax.customer.account.ecommerce.drop"
                   template="Exemptax_Integration::customer/ecommerce_drop_link.phtml"
                   after="-">
                <arguments>
                    <argument name="mode" xsi:type="string">iframe</argument>
                    <argument name="link_label" xsi:type="string" translate="true">Tax-Exempt Certificates</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
